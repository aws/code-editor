+ *--------------------------------------------------------------------------------------------*/
+
+/**
+ * Characters that let a file name break out of shell quoting or start new shell syntax when it
+ * is pasted into a command without escaping.
+ */
+const unsafeFileNameChars = /["'`$;|&<>\\\r\n]/;
+
+/** Characters after which a relative path can start. */
+const tokenBoundary = /[\s"'`=:,;|&<>()]/;
+
+/** Upper bound on directory listings per command, to keep the check fast. */
+const maxDirectoryReads = 128;
+
+export interface IUnsafeFileName {
+	/** The offending name, or undefined when the command referenced too many paths to check. */
+	readonly name: string | undefined;
+}
+
+/**
+ * Finds a file or folder name with shell special characters that appears verbatim in a terminal
+ * command, where it could change the meaning of the command.
+ *
+ * Paths in the command are resolved against real directory listings, starting from `/`, `~/`
+ * and the cwd, so only names that exist on disk are reported.
+ *
+ * @param readDirectory Returns the entry names of a POSIX directory, or undefined if it can't
+ * be listed.
+ */
+export async function findUnsafeFileNameInCommand(
+	text: string,
+	readDirectory: (path: string) => Promise<string[] | undefined>,
+	cwd: string | undefined,
+	userHome: string | undefined
+): Promise<IUnsafeFileName | undefined> {
+	if (!unsafeFileNameChars.test(text)) {
+		return undefined;
+	}
+	cwd = cwd && trimTrailingSlashes(cwd);
+	userHome = userHome && trimTrailingSlashes(userHome);
+
+	const listings = new Map<string, string[] | undefined>();
+	for (let i = 0; i < text.length; i++) {
+		let directory: string | undefined;
+		let offset = i;
+		if (text[i] === '/') {
+			directory = '/';
+			offset = i + 1;
+		} else if (userHome && text.startsWith('~/', i)) {
+			directory = userHome;
+			offset = i + 2;
+		} else if (i === 0 || tokenBoundary.test(text[i - 1])) {
+			directory = cwd;
+		}
+
+		// Follow the path at `offset` one directory at a time, checking each listing once
+		while (directory !== undefined) {
+			if (text.startsWith('/', offset)) {
+				offset += 1;
+				continue;
+			}
+			if (text.startsWith('./', offset)) {
+				offset += 2;
+				continue;
+			}
+			if (text.startsWith('../', offset)) {
+				directory = parentDirectory(directory);
+				offset += 3;
+				continue;
+			}
+
+			if (!listings.has(directory)) {
+				if (listings.size >= maxDirectoryReads) {
+					return { name: undefined };
+				}
+				const names = await tryReadDirectory(readDirectory, directory);
+				listings.set(directory, names);
+				const unsafeName = names?.find(name => unsafeFileNameChars.test(name) && (text.includes(name) || text.includes(toForwardSlashes(name))));
+				if (unsafeName !== undefined) {
+					return { name: unsafeName };
+				}
+			}
+
+			const child = findChildAt(listings.get(directory), text, offset);
+			if (child !== undefined) {
+				offset += child.length + 1;
+				directory = directory === '/' ? `/${child}` : `${directory}/${child}`;
+			} else {
+				directory = undefined;
+			}
+		}
+	}
+	return undefined;
+}
+
+/**
+ * Lists a directory, treating directories that can't be read as having no entries.
+ */
+async function tryReadDirectory(readDirectory: (path: string) => Promise<string[] | undefined>, directory: string): Promise<string[] | undefined> {
+	try {
+		return await readDirectory(directory);
+	} catch {
+		return undefined;
+	}
+}
+
+/**
+ * Returns the longest name that appears in `text` at `offset` followed by `/`.
+ */
+function findChildAt(names: string[] | undefined, text: string, offset: number): string | undefined {
+	let result: string | undefined;
+	for (const name of names ?? []) {
+		if ((result === undefined || name.length > result.length) && (text.startsWith(`${name}/`, offset) || text.startsWith(`${toForwardSlashes(name)}/`, offset))) {
+			result = name;
+		}
+	}
+	return result;
+}
+
+/**
+ * Extensions may rewrite backslashes to slashes before quoting a path.
+ */
+function toForwardSlashes(name: string): string {
+	return name.replace(/\\/g, '/');
+}
+
+/**
+ * Returns the parent of a POSIX directory, where the parent of `/` is `/`.
+ */
+function parentDirectory(directory: string): string {
+	return directory.slice(0, Math.max(directory.lastIndexOf('/'), 1));
+}
+
+/**
+ * Removes trailing slashes from a POSIX path, keeping `/` as is.
+ */
+function trimTrailingSlashes(path: string): string {
+	return path.length > 1 ? path.replace(/\/+$/, '') || '/' : path;
+}
