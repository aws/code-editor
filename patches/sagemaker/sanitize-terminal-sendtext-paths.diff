+import { deepStrictEqual } from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { findUnsafeFileNameInCommand } from '../../common/unsafeFileNames.js';
+
+suite('findUnsafeFileNameInCommand', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	const substitution = 'x" $(echo${IFS}PWNED${IFS}>';
+	const separator = 'x;touch${IFS}pwned;#';
+	const argument = 'x" -c "import os;os.system(\'id\')';
+	const backslash = 'a\\b" ; id ; #';
+	const unsafeFile = 'a";id;".py';
+
+	const files: Record<string, string[]> = {
+		'/': ['home', 'opt', 'tmp'],
+		'/home': ['u'],
+		'/home/u': ['proj', substitution, separator, argument, backslash, 'John\'s notes'],
+		'/home/u/proj': ['main.py', unsafeFile],
+		[`/home/u/${substitution}`]: ['tmp'],
+		[`/home/u/${substitution}/tmp`]: ['proof)#"'],
+		[`/home/u/${separator}`]: ['main.py'],
+	};
+	const readDirectory = async (path: string) => files[path];
+	const find = (text: string, cwd: string | undefined = '/home/u/proj') => findUnsafeFileNameInCommand(text, readDirectory, cwd, '/home/u');
+
+	test('reports referenced names with shell special characters', async () => {
+		deepStrictEqual(await Promise.all([
+			find(`/opt/conda/bin/python "/home/u/${substitution}/tmp/proof)#"/main.py"`),
+			find(`/opt/conda/bin/python /home/u/${separator}/main.py`),
+			find(`/opt/conda/bin/python "/home/u/${argument}/main.py"`),
+			find('/opt/conda/bin/python "/home/u/a/b" ; id ; #/main.py"'),
+			find(`cd "/home/u/proj" && python -u "${unsafeFile}"`, undefined),
+			find(`python "${unsafeFile}"`),
+			find(`python ./${unsafeFile}`),
+			find(`python "../${separator}/main.py"`),
+			find(`python ~/${separator}/main.py`, undefined),
+		]), [
+			{ name: substitution },
+			{ name: separator },
+			{ name: argument },
+			{ name: backslash },
+			{ name: unsafeFile },
+			{ name: unsafeFile },
+			{ name: unsafeFile },
+			{ name: separator },
+			{ name: separator },
+		]);
+	});
+
+	test('allows commands that only reference safe names', async () => {
+		deepStrictEqual(await Promise.all([
+			find('/opt/conda/bin/python "/home/u/proj/main.py"'),
+			find('echo "$HOME" | grep u; ls /tmp'),
+			findUnsafeFileNameInCommand('ls /home/u/proj', () => { throw new Error('unexpected read'); }, '/home/u', '/home/u'),
+			findUnsafeFileNameInCommand('cat "/home/u/a"', async () => { throw new Error('EACCES'); }, '/', '/home/u'),
+		]), [undefined, undefined, undefined, undefined]);
+	});
+
+	test('fails closed when too many directories are referenced', async () => {
+		const directories = Array.from({ length: 200 }, (_, i) => `d${i}`);
+		const text = `"${directories.map(directory => `/${directory}/`).join(' ')}"`;
+		deepStrictEqual(await findUnsafeFileNameInCommand(text, async path => path === '/' ? directories : [], undefined, undefined), { name: undefined });
+	});
+});
